<h1>Авторизация</h1>

<form asp-controller="Authorization" asp-action="AddUser" method="post">
    <div class="input-group mb-3">
        <input type="text" name="login" class="form-control" placeholder="Придумайте логин" required />
        <div class="input-group-append">
            <input type="text" name="password" class="form-control" placeholder="Придумайте пароль" required />
            <div class="input-group-append">
                <button type="submit" name="action" value="register" class="btn btn-primary">Зарегистрироваться</button>
                <button type="submit" name="action" value="login" class="btn btn-secondary">Войти</button>
            </div>
        </div>
    </form>